figma-developer-mcp v0.13.2

USAGE:
  figma-developer-mcp [flags...]
  figma-developer-mcp <command>

COMMANDS:
  fetch        

FLAGS:
      --env <string>                      Path to custom .env file to load environment variables from
      --figma-api-key <string>            Figma API key (Personal Access Token)
      --figma-oauth-token <string>        Figma OAuth Bearer token
      --format <string>                   Output format for design data: tree (default, compact), yaml, or json.
  -h, --help                              Show help
      --host <string>                     Host to run the server on
      --image-dir <string>                Base directory for image downloads. The download tool will only write files within this directory. Defaults to the current working directory.
      --json                              Output data from tools in JSON format. Back-compat alias for --format=json.
      --no-telemetry                      Disable usage telemetry (telemetry is on by default)
      --port <number>                     Port to run the server on
      --proxy <string>                    HTTP proxy URL for networks that require a proxy (e.g. http://proxy:8080). Pass 'none' to ignore HTTP_PROXY/HTTPS_PROXY from the environment and connect directly.
      --skip-image-downloads              Do not register the download_figma_images tool (skip image downloads)
      --stdio                             Run in stdio transport mode for MCP clients
      --version                           Show version

exit 0
